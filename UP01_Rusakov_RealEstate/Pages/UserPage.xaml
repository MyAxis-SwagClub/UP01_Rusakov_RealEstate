<Page x:Class="UP01_Rusakov_RealEstate.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог объектов"
      Style="{DynamicResource PageStyle}"
      IsVisibleChanged="Page_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PanelBorder}">
            <WrapPanel HorizontalAlignment="Center">
                <Grid>
                    <TextBox x:Name="SearchBox" Width="240" ToolTip="Введите часть адреса"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock x:Name="HintSearch" Text="Поиск по адресу" Style="{DynamicResource HintText}" />
                </Grid>
                <ComboBox x:Name="TypeFilter" Width="240" DisplayMemberPath="Name"
                          ToolTip="Тип недвижимости" SelectionChanged="Filter_Changed" />
                <ComboBox x:Name="SortBox" Width="240" ToolTip="Сортировка" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Цена (Возрастание)" />
                    <ComboBoxItem Content="Цена (Убывание)" />
                    <ComboBoxItem Content="Площадь (Возрастание)" />
                    <ComboBoxItem Content="Площадь (Убывание)" />
                </ComboBox>
                <CheckBox x:Name="OnlyMineCheck" Content="Только мои объекты"
                          ToolTip="Показать только объекты, где вы указаны агентом"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <Button Content="Сбросить фильтры" ToolTip="Вернуть фильтры по умолчанию" Click="ClearFilters_Click" />
            </WrapPanel>
        </Border>

        <TextBlock x:Name="CountText" Grid.Row="1" Margin="15,0,15,5" />

        <ListView x:Name="ListProperties" Grid.Row="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource CardBorder}">
                        <StackPanel>
                            <Grid Height="110" Background="{DynamicResource BgBrush}">
                                <TextBlock Text="Изображение отсутствует" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource HintBrush}" FontSize="12" />
                                <Image Stretch="UniformToFill" Source="{Binding Photo}" />
                            </Grid>
                            <TextBlock Text="{Binding PropertyType.Name}" FontWeight="Bold" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding Address}" TextWrapping="Wrap" FontSize="12" />
                            <TextBlock Text="{Binding Area, StringFormat='Площадь: {0} м²'}" FontSize="12" />
                            <TextBlock Text="{Binding Rooms, StringFormat='Комнат: {0}', TargetNullValue='Комнат: —'}" FontSize="12" />
                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="{Binding User.FIO, StringFormat='Агент: {0}'}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
