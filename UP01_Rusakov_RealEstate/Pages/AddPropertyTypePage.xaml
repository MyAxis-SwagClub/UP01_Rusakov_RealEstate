<Page x:Class="UP01_Rusakov_RealEstate.Pages.AddPropertyTypePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Тип недвижимости"
      Style="{DynamicResource PageStyle}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderText" Style="{DynamicResource HeaderText}" />

        <TextBlock Text="Название типа *" Margin="5,0" />
        <TextBox x:Name="TBTypeName" MaxLength="100" ToolTip="Название русскими буквами, например: Таунхаус"
                 PreviewTextInput="TBTypeName_PreviewTextInput" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" IsDefault="True" ToolTip="Сохранить тип" Click="ButtonSave_Click" />
            <Button Content="Очистить" ToolTip="Очистить поле" Click="ButtonClean_Click" />
        </StackPanel>
    </StackPanel>
</Page>
