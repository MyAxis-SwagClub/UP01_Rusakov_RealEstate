<Page x:Class="UP01_Rusakov_RealEstate.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация"
      Style="{DynamicResource PageStyle}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Регистрация нового пользователя" Style="{DynamicResource HeaderText}" />

        <TextBlock Text="Логин" Margin="5,0" />
        <Grid HorizontalAlignment="Center">
            <TextBox x:Name="txtbxLog" MaxLength="50" ToolTip="Латинские буквы и цифры, от 3 символов"
                     TextChanged="TxtbxLog_TextChanged" PreviewTextInput="Login_PreviewTextInput" />
            <TextBlock x:Name="HintLogin" Text="Введите логин" Style="{DynamicResource HintText}" />
        </Grid>

        <TextBlock Text="ФИО" Margin="5,5,5,0" />
        <Grid HorizontalAlignment="Center">
            <TextBox x:Name="txtbxFIO" MaxLength="150" ToolTip="Фамилия, имя и отчество русскими буквами"
                     TextChanged="TxtbxFIO_TextChanged" PreviewTextInput="Fio_PreviewTextInput" />
            <TextBlock x:Name="HintFio" Text="Введите ФИО" Style="{DynamicResource HintText}" />
        </Grid>

        <TextBlock Text="Пароль" Margin="5,5,5,0" />
        <Grid HorizontalAlignment="Center">
            <PasswordBox x:Name="passBxFrst" MaxLength="50" ToolTip="Не менее 6 символов, латиница и хотя бы одна цифра"
                         PasswordChanged="PassBxFrst_PasswordChanged" />
            <TextBlock x:Name="HintPass" Text="Введите пароль" Style="{DynamicResource HintText}" />
        </Grid>

        <TextBlock Text="Подтверждение пароля" Margin="5,5,5,0" />
        <Grid HorizontalAlignment="Center">
            <PasswordBox x:Name="passBxScnd" MaxLength="50" ToolTip="Повторите пароль"
                         PasswordChanged="PassBxScnd_PasswordChanged" />
            <TextBlock x:Name="HintPassSecond" Text="Повторите пароль" Style="{DynamicResource HintText}" />
        </Grid>

        <TextBlock Text="Новая учётная запись создаётся с ролью «Пользователь»."
                   Foreground="{DynamicResource HintBrush}" Margin="5,10,5,0" />

        <Button Content="Зарегистрироваться" IsDefault="True" Margin="5,15,5,5"
                ToolTip="Создать учётную запись" Click="RegButton_Click" />
    </StackPanel>
</Page>
