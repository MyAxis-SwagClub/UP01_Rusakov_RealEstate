<Page x:Class="UP01_Rusakov_RealEstate.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля"
      Style="{DynamicResource PageStyle}">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Смена пароля" Style="{DynamicResource HeaderText}" />

        <TextBlock Text="Логин" Margin="5,0" />
        <Grid HorizontalAlignment="Center">
            <TextBox x:Name="TbLogin" MaxLength="50" ToolTip="Логин учётной записи"
                     TextChanged="TbLogin_TextChanged" />
            <TextBlock x:Name="HintLogin" Text="Введите логин" Style="{DynamicResource HintText}" />
        </Grid>

        <TextBlock Text="Текущий пароль" Margin="5,5,5,0" />
        <Grid HorizontalAlignment="Center">
            <PasswordBox x:Name="CurrentPasswordBox" MaxLength="50" ToolTip="Пароль, который используется сейчас"
                         PasswordChanged="CurrentPasswordBox_PasswordChanged" />
            <TextBlock x:Name="HintCurrent" Text="Текущий пароль" Style="{DynamicResource HintText}" />
        </Grid>

        <TextBlock Text="Новый пароль" Margin="5,5,5,0" />
        <Grid HorizontalAlignment="Center">
            <PasswordBox x:Name="NewPasswordBox" MaxLength="50" ToolTip="Не менее 6 символов, латиница и хотя бы одна цифра"
                         PasswordChanged="NewPasswordBox_PasswordChanged" />
            <TextBlock x:Name="HintNew" Text="Новый пароль" Style="{DynamicResource HintText}" />
        </Grid>

        <TextBlock Text="Подтверждение пароля" Margin="5,5,5,0" />
        <Grid HorizontalAlignment="Center">
            <PasswordBox x:Name="ConfirmPasswordBox" MaxLength="50" ToolTip="Повторите новый пароль"
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
            <TextBlock x:Name="HintConfirm" Text="Повторите новый пароль" Style="{DynamicResource HintText}" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" IsDefault="True"
                    ToolTip="Сохранить новый пароль" Click="ButtonSave_Click" />
            <Button Content="Назад" ToolTip="Вернуться к авторизации" Click="ButtonBack_Click" />
        </StackPanel>
    </StackPanel>
</Page>
