<Page x:Class="UP01_Rusakov_RealEstate.Pages.PropertyTypeTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Типы недвижимости"
      Style="{DynamicResource PageStyle}"
      IsVisibleChanged="Page_IsVisibleChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PanelBorder}">
            <StackPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <Grid>
                        <TextBox x:Name="SearchBox" Width="240" ToolTip="Введите часть названия"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="HintSearch" Text="Поиск по названию" Style="{DynamicResource HintText}" />
                    </Grid>
                    <ComboBox x:Name="SortBox" Width="240" ToolTip="Сортировка" SelectionChanged="SortBox_SelectionChanged">
                        <ComboBoxItem Content="Название: от А до Я" />
                        <ComboBoxItem Content="Название: от Я до А" />
                        <ComboBoxItem Content="Больше объектов" />
                    </ComboBox>
                    <CheckBox x:Name="OnlyUsedCheck" Content="Только с объектами"
                              ToolTip="Показать только типы, у которых есть объекты"
                              Checked="OnlyUsedCheck_Changed" Unchecked="OnlyUsedCheck_Changed" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Добавить" ToolTip="Добавить новый тип" Click="ButtonAdd_Click" />
                    <Button Content="Удалить" ToolTip="Удалить выделенные типы" Click="ButtonDel_Click" />
                    <Button Content="Сбросить фильтры" ToolTip="Вернуть фильтры по умолчанию" Click="ClearFilters_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="DataGridType" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  ToolTip="Для удаления выделите строки (Ctrl или Shift)">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип недвижимости" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Количество объектов" Binding="{Binding Properties.Count}" Width="200" />
                <DataGridTemplateColumn Width="210">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Редактировать" Click="ButtonEdit_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="CountText" Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,10" />
    </Grid>
</Page>
