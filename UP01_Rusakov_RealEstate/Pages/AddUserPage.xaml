<Page x:Class="UP01_Rusakov_RealEstate.Pages.AddUserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Пользователь"
      Style="{DynamicResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="HeaderText" Style="{DynamicResource HeaderText}" />

            <TextBlock Text="Логин *" Margin="5,0" />
            <TextBox x:Name="TBLogin" MaxLength="50" ToolTip="Латинские буквы и цифры, от 3 символов"
                     PreviewTextInput="Login_PreviewTextInput" />

            <TextBlock x:Name="PassLabel" Text="Пароль *" Margin="5,5,5,0" />
            <PasswordBox x:Name="TBPass" MaxLength="50" ToolTip="Не менее 6 символов, латиница и хотя бы одна цифра" />

            <TextBlock Text="Роль *" Margin="5,5,5,0" />
            <ComboBox x:Name="cmbRole" ToolTip="Роль пользователя">
                <ComboBoxItem Content="User" />
                <ComboBoxItem Content="Admin" />
            </ComboBox>

            <TextBlock Text="ФИО *" Margin="5,5,5,0" />
            <TextBox x:Name="TBFio" MaxLength="150" ToolTip="Фамилия, имя и отчество русскими буквами"
                     PreviewTextInput="Fio_PreviewTextInput" />

            <TextBlock Text="Фото" Margin="5,5,5,0" />
            <TextBox x:Name="TBPhoto" IsReadOnly="True" ToolTip="Путь к файлу фотографии (необязательно)" />
            <Button Content="Выбрать фото" ToolTip="Выбрать файл изображения" Click="ButtonPhoto_Click" />

            <TextBlock Text="* — обязательные поля" Foreground="{DynamicResource HintBrush}" Margin="5" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" IsDefault="True" ToolTip="Сохранить данные" Click="ButtonSave_Click" />
                <Button Content="Очистить" ToolTip="Очистить все поля" Click="ButtonClean_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
