<Page x:Class="UP01_Rusakov_RealEstate.Pages.AddPropertyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Объект недвижимости"
      Style="{DynamicResource PageStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="HeaderText" Style="{DynamicResource HeaderText}" />

            <TextBlock Text="Тип недвижимости *" Margin="5,0" />
            <ComboBox x:Name="CBType" DisplayMemberPath="Name" ToolTip="Выберите тип объекта" />

            <TextBlock Text="Агент *" Margin="5,5,5,0" />
            <ComboBox x:Name="CBUser" DisplayMemberPath="FIO" ToolTip="Сотрудник, который ведёт объект" />

            <TextBlock Text="Дата размещения *" Margin="5,5,5,0" />
            <DatePicker x:Name="DPDate" ToolTip="С 01.01.2000 по сегодняшний день" />

            <TextBlock Text="Адрес *" Margin="5,5,5,0" />
            <TextBox x:Name="TBAddress" MaxLength="250" ToolTip="Полный адрес, не менее 10 символов" />

            <TextBlock Text="Площадь, м² *" Margin="5,5,5,0" />
            <TextBox x:Name="TBArea" MaxLength="9" ToolTip="Число от 1 до 100 000, можно с дробной частью"
                     PreviewTextInput="Area_PreviewTextInput" />

            <TextBlock Text="Количество комнат" Margin="5,5,5,0" />
            <TextBox x:Name="TBRooms" MaxLength="2" ToolTip="Целое число от 0 до 50 (можно не заполнять)"
                     PreviewTextInput="Digits_PreviewTextInput" />

            <TextBlock Text="Цена, ₽ *" Margin="5,5,5,0" />
            <TextBox x:Name="TBPrice" MaxLength="11" ToolTip="Целое число от 10 000 до 10 000 000 000"
                     PreviewTextInput="Digits_PreviewTextInput" />

            <TextBlock Text="Фото" Margin="5,5,5,0" />
            <TextBox x:Name="TBPhoto" IsReadOnly="True" ToolTip="Путь к файлу фотографии (необязательно)" />
            <Button Content="Выбрать фото" ToolTip="Выбрать файл изображения" Click="ButtonPhoto_Click" />

            <TextBlock Text="* — обязательные поля" Foreground="{DynamicResource HintBrush}" Margin="5" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" ToolTip="Сохранить объект" Click="ButtonSave_Click" />
                <Button Content="Очистить" ToolTip="Очистить все поля" Click="ButtonClean_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
